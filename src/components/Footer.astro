---
import { site, socials, teams, siteLocale } from '../config';
import { useTranslations } from '../i18n/ui';

const t = useTranslations();

const year = new Date().getFullYear();
const years = year > site.founded ? `${site.founded}–${year}` : `${site.founded}`;

const links = socials.filter((s) => s.url !== null);
const comps = Object.values(teams).filter((t) => t.url !== null);
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="name">{site.name[siteLocale]}</p>
      <p class="muted">{site.tagline[siteLocale]}</p>
    </div>

    {
      links.length > 0 && (
        <div>
          <h2>{t('footer.elsewhere')}</h2>
          <ul>
            {links.map((s) => (
              <li>
                <a href={s.url} rel="me noopener">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      comps.length > 0 && (
        <div>
          <h2>{t('footer.competing')}</h2>
          <ul>
            {comps.map((t) => (
              <li>
                <a href={t.url} rel="noopener">
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div>
      <h2>{t('footer.contact')}</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap bottom">
    <p class="muted">
      © {years} {site.name[siteLocale]}, {site.university[siteLocale]}.
    </p>
    <p class="muted">{t('footer.credit')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border-soft);
    background: var(--bg-inset);
    padding: 2.5rem 0 1.5rem;
    font-size: 0.9rem;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
  }

  .name {
    margin: 0 0 0.25rem;
    font-weight: 650;
    color: var(--text);
  }

  .muted {
    margin: 0;
    color: var(--text-faint);
  }

  h2 {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-soft);
    font-size: 0.8rem;
  }
</style>
