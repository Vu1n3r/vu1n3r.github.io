---
import FormattedDate from './FormattedDate.astro';
import { tagHref, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, author, tags, ctf, difficulty, draft } = post.data;
---

<article class="card">
  <div class="meta">
    <FormattedDate date={date} />
    <span class="sep" aria-hidden="true">·</span>
    <span class="author">{author}</span>
    {ctf && <><span class="sep" aria-hidden="true">·</span><span>{ctf}</span></>}
    <span class="difficulty" data-level={difficulty}>{difficulty}</span>
    {draft && <span class="draft">draft</span>}
  </div>

  <h2>
    <a href={`/blog/${post.id}/`}>{title}</a>
  </h2>

  <ul class="tags">
    {
      tags.map((tag) => (
        <li>
          <a class="tag" href={tagHref(tag)}>
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-faint);
    font-size: 0.8rem;
  }

  .author {
    color: var(--text-muted);
  }

  .sep {
    color: var(--border);
  }

  .difficulty {
    margin-left: auto;
  }

  .draft {
    padding: 0 0.4rem;
    border: 1px solid var(--medium);
    border-radius: var(--radius);
    color: var(--medium);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  h2 {
    margin: 0.4rem 0 0.6rem;
    font-size: 1.2rem;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--link);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
