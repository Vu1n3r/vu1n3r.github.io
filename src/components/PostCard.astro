---
import FormattedDate from './FormattedDate.astro';
import {
  tagHref,
  postHref,
  categoryHref,
  postRating,
  type Post,
} from '../lib/posts';
import { locales, siteLocale, categories } from '../config';
import { useTranslations, type UIKey } from '../i18n/ui';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, author, tags, ctf, draft, lang, category } = post.data;

// Difficulty on a CTF writeup, severity on a bug bounty report, nothing on a
// study note. The card doesn't care which — it renders whatever it gets.
const rating = postRating(post.data);

const t = useTranslations();
const categoryKey = categories.find((c) => c.slug === category)!.key;

// The card runs in the site's direction. Only the title uses the post's
// language; metadata labels follow the website locale.
const postLocale = locales[lang];
---

<article class="card" data-category={category} data-level={rating?.level}>
  <div class="top">
    {/* Raised above the stretched card link so it stays clickable. */}
    <a class="cat" href={categoryHref(category)}>{t(categoryKey as UIKey)}</a>
    <span class="sep" aria-hidden="true">·</span>
    <FormattedDate date={date} />
    {draft && <span class="draft">draft</span>}
    {
      lang !== siteLocale && (
        <span class="badge" lang={postLocale.htmlLang}>
          <span>{postLocale.nativeLabel}</span>
        </span>
      )
    }
  </div>

  {/*
    The link covers the whole card via ::after, so the entire card is a click
    target without nesting the tag links inside an <a>, which is invalid.
    The tag list sits above it on the z axis so those stay clickable.
  */}
  <h2 lang={postLocale.htmlLang} dir={postLocale.dir}>
    <a href={postHref(post.id)}>{title}</a>
  </h2>

  <div class="byline">
    {ctf && <p class="source"><span>{t('post.platform')}: <bdi>{ctf}</bdi></span></p>}
    <p class="author">
      <span>{t('post.author')}: <bdi>{author}</bdi></span>
    </p>
  </div>

  <footer class="bottom">
    <ul class="tags">
      {
        tags.slice(0, 3).map((tag) => (
          <li>
            <a class="tag" href={tagHref(tag)}>
              {tag}
            </a>
          </li>
        ))
      }
      {tags.length > 3 && <li class="more">+{tags.length - 3}</li>}
    </ul>

    {
      rating && (
        <span
          class="rating"
          data-level={rating.level}
          aria-label={`${t(`rating.${rating.scale}` as UIKey)}: ${rating.level}`}
        >
          {rating.level}
        </span>
      )
    }
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.4rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  /* Use the card's full width so the accent border follows its corner radius.
     A narrow filled strip would flatten its 14px radius down to the strip's
     own 3px width. */
  .card::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline: -1px;
    border-inline-start: 3px solid var(--level, var(--border));
    border-radius: inherit;
    pointer-events: none;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
  }

  .card[data-category='ctf']:hover,
  .card[data-category='ctf']:focus-within {
    border-color: var(--level);
  }

  .top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  .cat {
    position: relative;
    z-index: 1;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .cat:hover {
    text-decoration: underline;
  }

  .card[data-category='ctf']:hover .cat,
  .card[data-category='ctf']:focus-within .cat {
    color: var(--level);
  }

  .sep {
    color: var(--border);
  }

  .badge,
  .draft {
    padding: 0 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.7rem;
    unicode-bidi: isolate;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .badge span { transform: translateY(2px); }

  .draft {
    border-color: var(--level-medium);
    color: var(--level-medium);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  /* Stretches the link over the whole card. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card:hover h2 a {
    color: var(--link);
  }

  .card[data-category='ctf']:hover h2 a,
  .card[data-category='ctf']:focus-within h2 a {
    color: var(--level);
  }

  .card[data-category='ctf'] :global(a.tag:hover),
  .card[data-category='ctf'] :global(a.tag:focus-visible) {
    border-color: var(--level);
    color: var(--level);
  }

  .byline { display: grid; gap: 0.3rem; }

  .source,
  .author {
    margin: 0;
    color: var(--text-faint);
    font-size: 0.84rem;
  }

  .author { color: var(--text-muted); }

  .bottom {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Pins the footer to the bottom so cards of differing title length still
       line their tags and ratings up across a row. */
    margin-block-start: auto;
    padding-block-start: 0.6rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Above the stretched link, so tag links remain clickable. */
    position: relative;
    z-index: 1;
  }

  .more {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    align-self: center;
  }

  .rating {
    margin-inline-start: auto;
    font-size: 0.7rem;
  }
</style>
