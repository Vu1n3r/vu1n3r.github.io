---
import {
  siBluesky,
  siDiscord,
  siFacebook,
  siGithub,
  siHackthebox,
  siInstagram,
  siMastodon,
  siTelegram,
  siTiktok,
  siTryhackme,
  siTwitch,
  siX,
  siYoutube,
} from 'simple-icons';
import { locales, type AuthorSocialPlatform, type Locale } from '../config';
import { useTranslations } from '../i18n/ui';

interface Props {
  name: string;
  image?: string;
  socials?: { platform: AuthorSocialPlatform; url: string }[];
  locale: Locale;
}

const { name, image, socials = [], locale } = Astro.props;
const t = useTranslations(locale);

// Brand paths are rendered inline, so profile icons work without a client
// script or a third-party icon request. LinkedIn is kept here because it is
// not included in the current Simple Icons package.
const linkedInPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z';

const icons: Record<AuthorSocialPlatform, { label: string; path: string | null }> = {
  github: { label: 'GitHub', path: siGithub.path },
  linkedin: { label: 'LinkedIn', path: linkedInPath },
  x: { label: 'X', path: siX.path },
  instagram: { label: 'Instagram', path: siInstagram.path },
  youtube: { label: 'YouTube', path: siYoutube.path },
  discord: { label: 'Discord', path: siDiscord.path },
  telegram: { label: 'Telegram', path: siTelegram.path },
  tiktok: { label: 'TikTok', path: siTiktok.path },
  bluesky: { label: 'Bluesky', path: siBluesky.path },
  mastodon: { label: 'Mastodon', path: siMastodon.path },
  facebook: { label: 'Facebook', path: siFacebook.path },
  twitch: { label: 'Twitch', path: siTwitch.path },
  tryhackme: { label: 'TryHackMe', path: siTryhackme.path },
  hackthebox: { label: 'Hack The Box', path: siHackthebox.path },
  website: { label: t('post.website'), path: null },
};
---

<section class="author-card" aria-labelledby="author-card-name" lang={locales[locale].htmlLang} dir={locales[locale].dir}>
  <div class="identity">
    {image && <img class="avatar" src={image} alt="" width="40" height="40" loading="lazy" decoding="async" />}
    <div>
      <p class="label">{t('post.author')}</p>
      <h2 id="author-card-name"><bdi>{name}</bdi></h2>
    </div>
  </div>

  {socials.length > 0 && (
    <ul class="socials" aria-label={t('post.socials')}>
      {socials.map((social) => {
        const icon = icons[social.platform];
        return (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`${icon.label}: ${name}`} title={icon.label}>
              {icon.path ? (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={icon.path} />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.5 2.5 3.7 5.5 3.7 9s-1.2 6.5-3.7 9c-2.5-2.5-3.7-5.5-3.7-9S9.5 5.5 12 3Z" />
                </svg>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  )}
</section>

<style>
  .author-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 0.7rem 1rem;
    border: 1px solid color-mix(in srgb, var(--level-medium) 40%, var(--border-soft));
    border-inline-start: 3px solid var(--level-medium);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--level-medium) 7%, var(--bg-raised));
  }

  .identity { display: flex; align-items: center; gap: 0.65rem; min-width: 0; }

  .avatar {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--level-medium);
    border-radius: 50%;
    object-fit: cover;
  }

  .label { margin: 0; color: var(--level-medium); font-size: 0.68rem; }
  h2 { margin: 0; color: var(--text); font-size: 1rem; overflow-wrap: anywhere; }

  .socials { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .socials a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid color-mix(in srgb, var(--level-medium) 45%, var(--border));
    border-radius: 50%;
    color: var(--level-medium);
    text-decoration: none;
  }
  .socials a:hover,
  .socials a:focus-visible { border-color: var(--level-medium); background: color-mix(in srgb, var(--level-medium) 12%, transparent); }
  .socials svg { width: 1.4rem; height: 1.4rem; }

  @media (max-width: 30rem) {
    .author-card { padding: 0.7rem 0.85rem; }
  }
</style>
