---
import { nav, site, siteLocale } from '../config';
import { useTranslations, type UIKey } from '../i18n/ui';

const t = useTranslations();
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href);
---

<header class="site-header" dir="rtl">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={site.name[siteLocale]}>
      <img src="/CSC_logo.svg" alt="" class="brand-mark" width="80" height="80" />
      <span class="brand-name">{site.name[siteLocale]}<span lang="en">Cybersecurity Club</span></span>
    </a>

    <button class="menu-toggle" type="button" aria-label={t('a11y.toggleMenu')} aria-controls="primary-navigation" aria-expanded="false" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>

    <nav id="primary-navigation" aria-label={t('a11y.primaryNav')}>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {t(item.key as UIKey)}
          </a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = header?.querySelector<HTMLElement>('#primary-navigation');

  if (header && toggle && navigation) {
    const closeMenu = () => {
      header.removeAttribute('data-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else {
        header.setAttribute('data-menu-open', '');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });

    navigation.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) closeMenu();
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 48.01rem)').addEventListener('change', closeMenu);
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--border-soft);
    background: var(--bg);
  }
  .header-inner {
    max-width: 1840px;
    margin-inline: auto;
    min-height: 88px;
    padding: 1rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 56rem) minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
  }
  .brand { grid-column: 1; display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--text); }
  .brand-mark { width: 68px; height: 68px; object-fit: contain; transform: translateY(-5px); }
  .brand-name { font-size: 0.85rem; font-weight: 700; line-height: 1.6; }
  .brand-name span { display: block; font-size: 0.62rem; font-weight: 500; letter-spacing: 0.015em; }
  nav { grid-column: 2; padding: 0.4rem 1rem; border: 1px solid var(--border-soft); border-radius: 18px; background: var(--bg-raised); }
  nav ul { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 0.5rem 0.7rem; font-size: 1rem; font-weight: 500; color: var(--text); text-decoration: none; white-space: nowrap; }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent); }
  .menu-toggle { display: none; }
  @media (max-width: 85rem) {
    .header-inner { grid-template-columns: 1fr; gap: 1rem; padding-inline: 1.25rem; }
    .brand, nav { grid-column: 1; }
    nav ul { justify-content: center; gap: 1rem; }
  }
  @media (max-width: 48rem) {
    .header-inner { grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; min-height: 72px; padding-block: 0.55rem; }
    .brand { grid-column: 1; min-width: 0; }
    .brand-name { font-size: 0.76rem; }
    .brand-mark { width: 52px; height: 52px; transform: translateY(-3px); }
    .menu-toggle {
      grid-column: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      background: var(--bg-raised);
      color: var(--text);
      cursor: pointer;
    }
    .menu-toggle:hover, .site-header[data-menu-open] .menu-toggle { border-color: var(--accent); color: var(--accent); }
    .menu-toggle span { width: 20px; height: 2px; border-radius: 2px; background: currentColor; }
    nav {
      display: none;
      position: absolute;
      inset-block-start: calc(100% + 0.4rem);
      inset-inline: 1.25rem;
      padding: 0.45rem;
      border-radius: 12px;
      box-shadow: 0 12px 24px rgb(0 0 0 / 0.25);
    }
    .site-header[data-menu-open] nav { display: block; }
    nav ul { flex-direction: column; align-items: stretch; gap: 0; }
    nav a { padding: 0.7rem 0.85rem; white-space: normal; }
    nav a:hover, nav a:focus-visible { background: color-mix(in srgb, var(--accent) 8%, transparent); border-radius: 8px; }
  }
</style>
