---
import { nav, site, locales, type Locale } from '../config';
import {
  useTranslations,
  localizePath,
  stripLocale,
  otherLocales,
  type UIKey,
} from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The path with any locale prefix removed, so both the active-nav check and
// the language switcher work off the same locale-independent path.
const basePath = stripLocale(Astro.url.pathname);

const isCurrent = (href: string) =>
  href === '/' ? basePath === '/' : basePath.startsWith(href);

// The switcher keeps the reader where they are: /ar/blog/tags/web/ swaps to
// /blog/tags/web/, not to the home page. It is a plain link — no JS, and it
// works as a right-click-open-in-new-tab like any other link.
const alternates = otherLocales(locale).map((code) => ({
  code,
  href: localizePath(basePath, code),
  native: locales[code].nativeLabel,
}));
---

<header class="site-header">
  <div class="wrap bar">
    <a href={localizePath('/', locale)} class="brand">
      <span class="brand-mark" aria-hidden="true">{'>'}</span>
      <span class="brand-name">{site.shortName}</span>
    </a>

    <div class="right">
      <nav aria-label={t('a11y.primaryNav')}>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={localizePath(item.href, locale)}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {t(item.key as UIKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="lang" aria-label={t('a11y.langNav')}>
        {
          alternates.map((alt) => (
            <a
              href={alt.href}
              lang={locales[alt.code].htmlLang}
              hreflang={locales[alt.code].htmlLang}
              title={t('lang.switchTo')}
            >
              {alt.native}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    flex-wrap: wrap;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand-mark {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--bg-raised);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-raised);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  /* Separated from the nav by a rule so it reads as a control, not a
     destination. Mirrors automatically: it is a logical border. */
  .lang {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--border-soft);
  }

  .lang a {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.85rem;
    /* The label is always in the language being switched TO, so it must not
       inherit the current page's direction. */
    unicode-bidi: isolate;
  }

  .lang a:hover {
    border-color: var(--accent);
    color: var(--text);
    background: var(--bg-raised);
  }
</style>
