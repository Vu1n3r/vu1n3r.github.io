---
import { locales, siteLocale } from '../config';

interface Props {
  date: Date;
}

const { date } = Astro.props;

/**
 * Fixed timezone: the build machine's zone must not shift a post dated the
 * 1st to the 31st. Arabic uses Latin digits (nu-latn) — writeups are full of
 * ports, CVEs and byte counts in Latin digits, and switching numeral systems
 * for the date alone reads as an inconsistency rather than a translation.
 */
const tag = siteLocale === 'ar' ? 'ar-u-ca-gregory-nu-latn' : 'en-GB';

const display = date.toLocaleDateString(tag, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString()} lang={locales[siteLocale].htmlLang}>{display}</time>
