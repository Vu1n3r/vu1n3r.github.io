---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import { localePaths } from '../../../i18n/routes';
import { useTranslations, localizePath } from '../../../i18n/ui';
import { getPosts, tagHref, postHref } from '../../../lib/posts';
import { locales } from '../../../config';

/**
 * Every published post in every UI locale. The chrome follows the reader's
 * locale; the article keeps the language it was written in. `posts` is
 * newest-first, so the entry before a post is NEWER and the one after older.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();

  return localePaths().flatMap((entry) =>
    posts.map((post, i) => ({
      params: { ...entry.params, slug: post.id },
      props: {
        ...entry.props,
        post,
        newer: posts[i - 1] ?? null,
        older: posts[i + 1] ?? null,
      },
    })),
  );
};

const { locale, post, newer, older } = Astro.props;
const { title, date, author, tags, ctf, difficulty, draft, lang } = post.data;

const t = useTranslations(locale);

// The article's own language, which may differ from the reader's UI locale.
const content = locales[lang];

const { Content, headings } = await render(post);
---

<BaseLayout
  title={title}
  description={`${difficulty} · ${author}`}
  locale={locale}
>
  <article class="post">
    <header class="head">
      <p class="eyebrow">
        <a href={localizePath('/blog/', locale)}>{t('blog.title')}</a>
      </p>

      <h1 lang={content.htmlLang} dir={content.dir}>{title}</h1>

      <div class="meta">
        <FormattedDate date={date} locale={locale} />
        <span class="sep" aria-hidden="true">·</span>
        <span class="author">{author}</span>
        {ctf && <><span class="sep" aria-hidden="true">·</span><span>{ctf}</span></>}
        <span class="difficulty" data-level={difficulty}>{difficulty}</span>
      </div>

      {
        lang !== locale && (
          <p class="lang-notice" lang={content.htmlLang}>
            {t('post.translatedNotice')}
          </p>
        )
      }

      {draft && <p class="draft-notice">{t('post.draft')}</p>}

      <ul class="tags">
        {tags.map((tag) => (
          <li>
            <a class="tag" href={tagHref(tag, locale)}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    </header>

    <div class="body">
      {/*
        Article first in source order: it is the primary content, and on a
        narrow screen the reader should reach it without scrolling past a
        contents list. CSS `order` hoists the TOC above it on mobile and
        parks it in the side column on desktop.

        lang/dir here, not on <html>: the writeup renders in the language it
        was written in, inside chrome that stays in the reader's language.
      */}
      <div class="prose" lang={content.htmlLang} dir={content.dir}>
        <Content />
      </div>

      <aside class="side">
        <TableOfContents headings={headings} locale={locale} contentLang={lang} />
      </aside>
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="pager" aria-label={t('post.moreWriteups')}>
        <div class="prev">
          {older && (
            <a href={postHref(older.id, locale)}>
              <span class="dir">← {t('post.older')}</span>
              <span
                class="t"
                lang={locales[older.data.lang].htmlLang}
                dir={locales[older.data.lang].dir}
              >
                {older.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="next">
          {newer && (
            <a href={postHref(newer.id, locale)}>
              <span class="dir">{t('post.newer')} →</span>
              <span
                class="t"
                lang={locales[newer.data.lang].htmlLang}
                dir={locales[newer.data.lang].dir}
              >
                {newer.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }
</BaseLayout>

<style>
  .eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
  }

  .eyebrow a {
    color: var(--text-faint);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--link);
  }

  .head {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .head h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    max-width: 24ch;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  .author {
    color: var(--text-muted);
  }

  .sep {
    color: var(--border);
  }

  .lang-notice {
    margin: 1rem 0 0;
    color: var(--text-faint);
    font-size: 0.85rem;
    unicode-bidi: isolate;
  }

  .draft-notice {
    margin: 1rem 0 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--medium);
    border-radius: var(--radius);
    color: var(--medium);
    font-size: 0.85rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .body {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
  }

  /* Only below the side-column breakpoint does the contents list sit in the
     flow, and then it goes above the article — a reader on a phone should
     see where they are before they start scrolling. */
  .side {
    order: -1;
  }

  /* 48rem, not 60rem: at 960px the sidebar was only appearing on wide
     desktop windows, so most laptops got the stacked layout and the article
     started a screenful below the title. The contents column flexes with the
     viewport so it can move aside sooner without squeezing the prose. */
  @media (min-width: 48rem) {
    .body {
      grid-template-columns: minmax(0, 1fr) clamp(10rem, 18vw, 15rem);
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: start;
    }

    .side {
      order: 0;
    }
  }

  .pager {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .next a {
    text-align: end;
  }

  .dir {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .t {
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    unicode-bidi: isolate;
  }
</style>
