---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { localePaths } from '../../../i18n/routes';
import { useTranslations, localizePath } from '../../../i18n/ui';
import { getPosts, getTags, tagHref } from '../../../lib/posts';
import { repo } from '../../../config';

export const getStaticPaths: GetStaticPaths = () => localePaths();

const { locale } = Astro.props;
const t = useTranslations(locale);

// Both locales list every writeup. The club is small and bilingual; hiding
// an Arabic writeup from an English reader would hide half the archive.
// Each card marks its own language so the choice is visible before clicking.
const posts = await getPosts();
const tags = await getTags();
---

<BaseLayout title={t('blog.title')} locale={locale}>
  <header class="page-head">
    <h1>{t('blog.title')}</h1>
    <p>
      {t('blog.intro')} {t('blog.cta')}{' '}
      <a href={repo.url}>{t('blog.ctaLink')}</a>.
    </p>
  </header>

  {
    tags.length > 0 && (
      <nav class="tag-bar" aria-label={t('tags.title')}>
        {tags.map((tag) => (
          <a class="tag" href={tagHref(tag.label, locale)}>
            {tag.label} <span class="count">{tag.count}</span>
          </a>
        ))}
        <a class="tag all" href={localizePath('/blog/tags/', locale)}>
          {t('blog.allTags')} →
        </a>
      </nav>
    )
  }

  {
    posts.length > 0 ? (
      <div class="list">
        {posts.map((post) => (
          <PostCard post={post} locale={locale} />
        ))}
      </div>
    ) : (
      <p class="empty">
        {t('blog.empty')} <a href={repo.url}>{t('blog.ctaLink')}</a>.
      </p>
    )
  }
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .page-head h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .page-head p {
    margin: 0;
    color: var(--text-muted);
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .count {
    color: var(--text-faint);
  }

  .all {
    border-style: dashed;
  }

  .empty {
    padding: 3rem 0;
    color: var(--text-muted);
  }
</style>
