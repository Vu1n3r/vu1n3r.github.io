---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTags, tagHref } from '../../../lib/posts';

const tags = await getTags();
---

<BaseLayout title="Tags" description="Browse club writeups by topic.">
  <header class="page-head">
    <h1>Tags</h1>
    <p>
      {tags.length} tag{tags.length === 1 ? '' : 's'} in use. Reuse an existing
      one where it fits rather than inventing a near-duplicate.
    </p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="grid">
        {tags.map((t) => (
          <li>
            <a href={tagHref(t.label)}>
              <span class="label">{t.label}</span>
              <span class="count">
                {t.count} post{t.count === 1 ? '' : 's'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No tags yet — no posts yet.</p>
    )
  }

  <p class="back"><a href="/blog/">← All writeups</a></p>
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .page-head h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .page-head p {
    margin: 0;
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
  }

  .grid a:hover {
    border-color: var(--accent);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .count {
    color: var(--text-faint);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .empty {
    color: var(--text-muted);
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
