---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import { useTranslations, plural, type UIKey } from '../../../i18n/ui';
import { getPosts } from '../../../lib/posts';
import { categories } from '../../../config';

/**
 * Every supported category has a page so the blog filter has no dead links.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      slug: category.slug,
      key: category.key,
      posts: posts.filter((post) => post.data.category === category.slug),
    },
  }));
};

const { slug, key, posts } = Astro.props;
const t = useTranslations();
const label = t(key as UIKey);
---

<BaseLayout title={label}>
  <header class="page-head">
    <h1>{label}</h1>
    <p class="count">
      {posts.length}{' '}
      {plural(t, posts.length, 'post.writeupCount_one', 'post.writeupCount_other')}
    </p>
  </header>

  <CategoryNav current={slug} />

  {posts.length > 0 ? (
    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <p class="empty">{t('category.empty')} <a href="/blog/">{t('category.all')}</a></p>
  )}
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    margin-bottom: 1.25rem;
  }

  .page-head h1 {
    margin: 0 0 0.35rem;
    font-size: 2rem;
  }

  .count {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 1rem;
  }

  .empty { color: var(--text-muted); }
</style>
