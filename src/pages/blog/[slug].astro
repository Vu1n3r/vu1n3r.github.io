---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { useTranslations } from '../../i18n/ui';
import { getPosts, tagHref, postHref } from '../../lib/posts';
import { locales, siteLocale } from '../../config';

/**
 * One page per published post. `posts` is newest-first, so the entry before
 * a post in the array is the NEWER one and the entry after is older.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
};

const { post, newer, older } = Astro.props;
const { title, date, author, tags, ctf, difficulty, draft, lang } = post.data;

const t = useTranslations();

// The language this writeup was written in. It sets the direction of the
// whole page — an English writeup lays out left-to-right, nav included.
const content = locales[lang];

const { Content, headings } = await render(post);
---

<BaseLayout
  title={title}
  description={`${difficulty} · ${author}`}
  contentLang={lang}
  wide
>
  <div class="layout">
    <article class="post">
      <header class="head">
      <p class="eyebrow">
        <a href="/blog/">{t('blog.title')}</a>
      </p>

      <h1 lang={content.htmlLang}>{title}</h1>

      <div class="meta">
        <FormattedDate date={date} />
        <span class="sep" aria-hidden="true">·</span>
        <span class="author">{author}</span>
        {ctf && <><span class="sep" aria-hidden="true">·</span><span>{ctf}</span></>}
        <span class="difficulty" data-level={difficulty}>{difficulty}</span>
      </div>

      {
        lang !== siteLocale && (
          <p class="lang-notice" lang={content.htmlLang}>
            {t('post.translatedNotice')}
          </p>
        )
      }

      {draft && <p class="draft-notice">{t('post.draft')}</p>}

      <ul class="tags">
        {tags.map((tag) => (
          <li>
            <a class="tag" href={tagHref(tag)}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    </header>

    {/* Direction is already on <html>; this only names the language. */}
    <div class="prose" lang={content.htmlLang}>
      <Content />
    </div>
  </article>

  {/*
    The contents list is a sibling of the article, not a column inside it.
    It sits in the page's outer track, so the article's width is identical
    whether or not it is showing.
  */}
  <aside class="side">
    <TableOfContents headings={headings} />
  </aside>

  {
    (newer || older) && (
      <nav class="pager" aria-label={t('post.moreWriteups')}>
        <div class="prev">
          {older && (
            <a href={postHref(older.id)}>
              <span class="dir">← {t('post.older')}</span>
              <span
                class="t"
                lang={locales[older.data.lang].htmlLang}
                dir={locales[older.data.lang].dir}
              >
                {older.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="next">
          {newer && (
            <a href={postHref(newer.id)}>
              <span class="dir">{t('post.newer')} →</span>
              <span
                class="t"
                lang={locales[newer.data.lang].htmlLang}
                dir={locales[newer.data.lang].dir}
              >
                {newer.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }
  </div>
</BaseLayout>

<style>
  /* Wider than the site's default measure: writeups are screenshot-heavy
     and terminal output is long, and 68ch renders both too small. */
  .layout {
    --post-measure: 44rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
  }

  .eyebrow a {
    color: var(--text-faint);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--link);
  }

  .head {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .head h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    max-width: 24ch;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  .author {
    color: var(--text-muted);
  }

  .sep {
    color: var(--border);
  }

  .lang-notice {
    margin: 1rem 0 0;
    color: var(--text-faint);
    font-size: 0.85rem;
    unicode-bidi: isolate;
  }

  .draft-notice {
    margin: 1rem 0 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--medium);
    border-radius: var(--radius);
    color: var(--medium);
    font-size: 0.85rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* The article's track is a fixed reading measure and never changes width.
     The contents list gets its own outer track, so turning it on or off
     leaves the prose identical — that is the whole point of moving it out
     of a shared wrapper. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--post-measure));
    justify-content: center;
    column-gap: 3.5rem;
  }

  .post,
  .pager {
    grid-column: 1;
    min-width: 0;
  }

  .prose {
    max-width: 100%;
    padding-top: 2rem;
  }

  /* Hidden until there is genuinely room beside a full-width article. Below
     this the reader gets the article directly under its title, with nothing
     wedged between them. */
  .side {
    display: none;
  }

  /* 72rem = article (44rem) + gap (3.5rem) + contents (15rem) + page gutter.
     The sidebar only appears once all of that fits without borrowing from
     the article. */
  @media (min-width: 72rem) {
    .layout {
      grid-template-columns: minmax(0, var(--post-measure)) minmax(12rem, 15rem);
    }

    .side {
      display: block;
      grid-column: 2;
      grid-row: 1;
      /* Stretch to the article's height so the sticky child inside has room
         to travel; without this the aside is only as tall as the list and
         sticky has nothing to stick within. */
      align-self: stretch;
    }
  }

  .pager {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .next a {
    text-align: end;
  }

  .dir {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .t {
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    unicode-bidi: isolate;
  }
</style>
