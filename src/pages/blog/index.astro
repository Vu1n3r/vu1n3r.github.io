---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { useTranslations } from '../../i18n/ui';
import { getPosts, getTags, tagHref } from '../../lib/posts';
import { repo } from '../../config';

const t = useTranslations();

// Every writeup is listed regardless of the language it was written in.
// Cards mark a non-Arabic writeup so the reader knows before clicking.
const posts = await getPosts();
const tags = await getTags();
---

<BaseLayout title={t('blog.title')}>
  <header class="page-head">
    <h1>{t('blog.title')}</h1>
    <p>
      {t('blog.intro')} {t('blog.cta')}{' '}
      <a href={repo.url}>{t('blog.ctaLink')}</a>.
    </p>
  </header>

  {
    tags.length > 0 && (
      <nav class="tag-bar" aria-label={t('tags.title')}>
        {tags.map((tag) => (
          <a class="tag" href={tagHref(tag.label)}>
            {tag.label} <span class="count">{tag.count}</span>
          </a>
        ))}
        <a class="tag all" href="/blog/tags/">
          {t('blog.allTags')} →
        </a>
      </nav>
    )
  }

  {
    posts.length > 0 ? (
      <div class="list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="empty">
        {t('blog.empty')} <a href={repo.url}>{t('blog.ctaLink')}</a>.
      </p>
    )
  }
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .page-head h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .page-head p {
    margin: 0;
    color: var(--text-muted);
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .count {
    color: var(--text-faint);
  }

  .all {
    border-style: dashed;
  }

  .empty {
    padding: 3rem 0;
    color: var(--text-muted);
  }
</style>
