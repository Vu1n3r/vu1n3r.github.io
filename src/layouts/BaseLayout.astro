---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import '../styles/global.css';

interface Props {
  /** Page title, shown before the site name. Omit on the home page. */
  title?: string;
  /** Meta description for this page. Falls back to the site description. */
  description?: string;
  /** Constrain the main column to a comfortable reading measure. */
  narrow?: boolean;
}

const { title, description = site.description, narrow = false } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.university}`;

// Astro.site comes from `site` in astro.config.mjs. Guarding keeps the build
// working if someone clears it, rather than throwing at render time.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['wrap', 'main', { narrow }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main {
    padding-block: 2.5rem 1rem;
    min-height: 60vh;
  }

  .main.narrow {
    max-width: calc(var(--measure) + 2.5rem);
  }
</style>
