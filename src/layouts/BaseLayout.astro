---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, locales, siteLocale, type Locale } from '../config';
import { useTranslations } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  /** Page title, shown before the site name. Omit on the home page. */
  title?: string;
  /** Meta description for this page. Falls back to the site description. */
  description?: string;
  /** Constrain the main column to a comfortable reading measure. */
  narrow?: boolean;
  /**
   * Widen the main column beyond the site container. For pages that park a
   * secondary column (a contents list) outside the reading measure, so the
   * prose keeps its full width instead of paying for the sidebar.
   */
  wide?: boolean;
  /**
   * Language of this page's main content. The site chrome is always Arabic,
   * but an English writeup sets this to 'en' so the whole page renders
   * left-to-right. Defaults to the site language.
   */
  contentLang?: Locale;
}

const {
  title,
  description,
  narrow = false,
  wide = false,
  contentLang = siteLocale,
} = Astro.props;

const t = useTranslations();

// The page's language stays the site's — the nav and footer are Arabic on
// every page. Only `dir` follows the content, so an English writeup lays the
// page out left-to-right without misdescribing the chrome around it.
const chrome = locales[siteLocale];
const dir = locales[contentLang].dir;

const pageTitle = title
  ? `${title} — ${site.name[siteLocale]}`
  : `${site.name[siteLocale]} — ${site.university[siteLocale]}`;

const metaDescription = description ?? site.description[siteLocale];

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

<html lang={chrome.htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=a69e71b7" />
    <link rel="canonical" href={canonical} />


    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name[siteLocale]} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={chrome.htmlLang} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header />
    <main id="main" class:list={['wrap', 'main', { narrow, wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main {
    padding-block: 3.5rem 1rem;
    min-height: 60vh;
  }

  .main.narrow {
    max-width: calc(var(--measure) + 2.5rem);
  }

  .main.wide {
    max-width: 84rem;
  }

  @media (max-width: 40rem) {
    .main { padding-block-start: 1.5rem; }
  }
</style>
