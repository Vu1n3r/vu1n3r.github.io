---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, locales, defaultLocale, type Locale } from '../config';
import { useTranslations, localizePath, stripLocale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  /** Page title, shown before the site name. Omit on the home page. */
  title?: string;
  /** Meta description for this page. Falls back to the site description. */
  description?: string;
  /** Constrain the main column to a comfortable reading measure. */
  narrow?: boolean;
  /**
   * Widen the main column beyond the site container. For pages that park a
   * secondary column (a contents list) outside the reading measure, so the
   * prose keeps its full width instead of paying for the sidebar.
   */
  wide?: boolean;
  /**
   * UI locale: nav, footer and the page's own direction. A post written in
   * another language sets direction on its own <article>, not here — the
   * chrome stays in the language the reader chose.
   */
  locale?: Locale;
}

const {
  title,
  description,
  narrow = false,
  wide = false,
  locale = defaultLocale,
} = Astro.props;

const t = useTranslations(locale);
const active = locales[locale];

const pageTitle = title
  ? `${title} — ${site.name[locale]}`
  : `${site.name[locale]} — ${site.university[locale]}`;

const metaDescription = description ?? site.description[locale];

const basePath = stripLocale(Astro.url.pathname);

const url = (path: string) =>
  Astro.site ? new URL(path, Astro.site).href : path;

const canonical = url(localizePath(basePath, locale));

// One alternate per locale plus x-default, so a search engine serves the
// right language and does not treat the two as duplicates of each other.
const alternates = (Object.keys(locales) as Locale[]).map((code) => ({
  hreflang: locales[code].htmlLang,
  href: url(localizePath(basePath, code)),
}));
---

<html lang={active.htmlLang} dir={active.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={url(localizePath(basePath, defaultLocale))}
    />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name[locale]} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={active.htmlLang} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header locale={locale} />
    <main id="main" class:list={['wrap', 'main', { narrow, wide }]}>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .main {
    padding-block: 2.5rem 1rem;
    min-height: 60vh;
  }

  .main.narrow {
    max-width: calc(var(--measure) + 2.5rem);
  }

  .main.wide {
    max-width: 76rem;
  }
</style>
